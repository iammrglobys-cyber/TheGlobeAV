<Window x:Class="TheGlobeAV.DiscordSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TheGlobeAV - Discord Settings"
        Width="650"
        Height="390"
        WindowStartupLocation="CenterOwner"
        Background="#090D18"
        Foreground="#EAF0FF">

    <StackPanel Margin="25">

        <TextBlock Text="DISCORD INTEGRATION"
                   FontSize="23"
                   FontWeight="Bold"/>

        <TextBlock Text="Configure where GlobeAV sends inspection reports."
                   Foreground="#8493AC"
                   Margin="0,8,0,20"/>

        <TextBlock Text="DISCORD WEBHOOK URL"
                   Foreground="#72AEFF"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <PasswordBox x:Name="WebhookPassword"
                     Height="43"
                     Padding="10"
                     Background="#182337"
                     Foreground="White"
                     BorderBrush="#344968"/>

        <TextBlock Text="Your webhook is encrypted using Windows DPAPI."
                   Foreground="#8493AC"
                   FontSize="11"
                   Margin="0,8,0,20"/>

        <WrapPanel>

            <Button Content="SAVE WEBHOOK"
                    Click="Save_Click"
                    Background="#2878ED"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="17,12"
                    Margin="0,0,10,0"/>

            <Button Content="SAVE AND TEST"
                    Click="Test_Click"
                    Background="#26364F"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="17,12"/>

        </WrapPanel>

        <TextBlock x:Name="StatusText"
                   Text="No connection test performed."
                   Foreground="#8493AC"
                   TextWrapping="Wrap"
                   Margin="0,20,0,0"/>

    </StackPanel>
</Window>
