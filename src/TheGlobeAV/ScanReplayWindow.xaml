<Window x:Class="TheGlobeAV.ScanReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TheGlobeAV - Scan Replay"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#090D18"
        Foreground="#EAF0FF">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="SCAN REPLAY"
                       FontSize="25"
                       FontWeight="Bold"/>

            <TextBlock Text="Search and replay previously recorded file inspections."
                       Foreground="#8493AC"
                       Margin="0,5,0,12"/>

            <DockPanel>
                <Button Content="SEARCH"
                        Width="110"
                        Click="Search_Click"
                        DockPanel.Dock="Right"
                        Background="#2878ED"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12"/>

                <TextBox x:Name="SearchBox"
                         Height="40"
                         FontSize="14"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         Background="#182337"
                         Foreground="White"
                         BorderBrush="#344968"/>
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#111827"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,12,0">

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="SAVED INSPECTIONS"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <ListBox x:Name="RecordsList"
                             Background="#0B1220"
                             Foreground="White"
                             BorderThickness="0"
                             SelectionChanged="RecordsList_SelectionChanged">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                                    <TextBlock Text="{Binding FilePath}"
                                               Foreground="#8493AC"
                                               FontSize="10"
                                               TextWrapping="Wrap"/>
                                    <Separator Margin="0,7,0,3"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#111827"
                    CornerRadius="10"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="INSPECTION TIMELINE"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="SelectedFileText"
                                   Text="Select a saved inspection."
                                   Foreground="#8493AC"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,12"/>

                        <TextBlock x:Name="ReplayPositionText"
                                   Text="Ready"
                                   Foreground="#64A8FF"
                                   FontSize="12"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="ReplayEventsList"
                             Background="#0B1220"
                             Foreground="#DCE8FA"
                             BorderBrush="#263A56"
                             Margin="0,12,0,12"
                             FontSize="12"
                             Padding="10"/>

                    <StackPanel Grid.Row="2">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="PLAYBACK SPEED"
                                       Foreground="#8493AC"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SpeedText"
                                       Text="1.0x"
                                       Foreground="#64A8FF"
                                       FontWeight="Bold"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>

                        <Slider x:Name="SpeedSlider"
                                Minimum="0.1"
                                Maximum="2"
                                Value="1"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="False"
                                ValueChanged="SpeedSlider_ValueChanged"/>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="PLAY"
                                    Click="Play_Click"
                                    Padding="18,10"
                                    Margin="0,0,8,0"/>

                            <Button Content="PAUSE"
                                    Click="Pause_Click"
                                    Padding="18,10"
                                    Margin="0,0,8,0"/>

                            <Button Content="STEP"
                                    Click="Step_Click"
                                    Padding="18,10"
                                    Margin="0,0,8,0"/>

                            <Button Content="RESTART"
                                    Click="Restart_Click"
                                    Padding="18,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
